<Window x:Class="BPM.App.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户配置档"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="130" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,10" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="4" />
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="4" />
      </Style>
    </Grid.Resources>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="显示名" />
    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows 用户名" />
    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
             Text="{Binding WindowsUser, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows 密码" />
    <PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordInput" />

    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap"
               Margin="0,0,0,10"
               Text="密码仅写入 Windows 凭据管理器,不会保存到配置文件。编辑时留空表示保留原密码。" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Battle.net 路径" />
    <TextBox Grid.Row="4" Grid.Column="1" x:Name="BattleNetPathInput"
             Text="{Binding BattleNetPath, UpdateSourceTrigger=PropertyChanged}" />
    <Button Grid.Row="4" Grid.Column="2" Content="浏览…" Margin="8,0,0,10" Click="BrowseBattleNet_Click" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="魔兽世界目录" />
    <TextBox Grid.Row="5" Grid.Column="1" x:Name="WowPathInput"
             Text="{Binding WowPath, UpdateSourceTrigger=PropertyChanged}" />
    <Button Grid.Row="5" Grid.Column="2" Content="浏览…" Margin="8,0,0,10" Click="BrowseWow_Click" />

    <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14"
              Content="启动 Battle.net 后自动启动《魔兽世界》"
              IsChecked="{Binding AutoLaunchWow}" />

    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="保存" IsDefault="True" Click="Save_Click" />
      <Button Content="取消" IsCancel="True" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
