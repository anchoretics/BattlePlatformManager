<Window x:Class="BPM.App.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户配置档" Icon="/BPM;component/Assets/BPM.ico"
        Width="660" MinWidth="560" MinHeight="480" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="16" x:Name="EditorForm">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="130" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,10" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="4" />
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="4" />
      </Style>
    </Grid.Resources>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="显示名" />
    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows 用户名" />
    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WindowsUserInput"
             Text="{Binding WindowsUser, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows 密码" />
    <PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordInput" />

    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,10" x:Name="CreateUserOptions">
      <CheckBox x:Name="CreateUserCheckBox"
                Content="保存时创建 Windows 本地用户（无需先登录桌面）"
                Checked="CreateUserMode_Changed" Unchecked="CreateUserMode_Changed" />
      <CheckBox x:Name="InitializeExistingUserCheckBox" Margin="0,6,0,0"
                Content="仅初始化已有本地用户（继续未完成的创建）"
                Checked="CreateUserMode_Changed" Unchecked="CreateUserMode_Changed" />
      <TextBlock x:Name="CreateUserHint" Visibility="Collapsed" Foreground="Gray" TextWrapping="Wrap"
                 Margin="20,6,0,0"
                 Text="需要管理员权限。创建普通用户并初始化配置,密码保存到凭据管理器。系统用户创建后会保留,删除 BPM 配置不会删除系统用户。" />
    </StackPanel>

    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" TextWrapping="Wrap"
               Margin="0,0,0,10"
               Text="密码仅写入 Windows 凭据管理器,不会保存到配置文件。创建系统账号必须填写密码;使用已保存凭据时可留空。" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="Battle.net 路径" />
    <TextBox Grid.Row="5" Grid.Column="1" x:Name="BattleNetPathInput"
             Text="{Binding BattleNetPath, UpdateSourceTrigger=PropertyChanged}" />
    <Button Grid.Row="5" Grid.Column="2" Content="浏览…" Tag="{StaticResource IconFolder}" Style="{StaticResource IconButton}" Margin="8,0,0,10" Click="BrowseBattleNet_Click" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="魔兽世界目录" />
    <TextBox Grid.Row="6" Grid.Column="1" x:Name="WowPathInput"
             Text="{Binding WowPath, UpdateSourceTrigger=PropertyChanged}" />
    <Button Grid.Row="6" Grid.Column="2" Content="浏览…" Tag="{StaticResource IconFolder}" Style="{StaticResource IconButton}" Margin="8,0,0,10" Click="BrowseWow_Click" />

    <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14"
              Content="启动 Battle.net 后自动启动《魔兽世界》"
              IsChecked="{Binding AutoLaunchWow}" />

    <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Margin="0,0,0,16" Background="#EBF3FF">
      <CheckBox Margin="12,12,12,6" Content="启用浏览器登录兼容辅助（建议开启）"
                IsChecked="{Binding BrowserLoginAssistEnabled}"/>
      <TextBlock Margin="12,0,12,12" Foreground="#415570" TextWrapping="Wrap"
                 Text="BPM 启动时自动请求管理员权限。需要网页登录时，辅助会用此 Windows 用户打开 Edge，未安装时尝试机器级 Chrome。无需设置默认浏览器；原生流程正常或出现重复网页时可关闭。若仍无法登录，请按主界面指引手动登录一次该 Windows 桌面。"/>
    </StackPanel>

    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SaveButton" Content="保存" Tag="{StaticResource IconSave}" Style="{StaticResource IconButton}" IsDefault="True" Click="Save_Click" />
      <Button Content="取消" Tag="{StaticResource IconClose}" Style="{StaticResource IconButton}" IsCancel="True" Margin="0" />
    </StackPanel>
  </Grid>
  </ScrollViewer>
</Window>
