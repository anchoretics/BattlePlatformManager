  <DataTemplate x:Key="IconButtonContent">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding}" Style="{x:Null}" Margin="0" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>
