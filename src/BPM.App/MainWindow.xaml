<Window x:Class="BPM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPM · 战网配置管理" Icon="/BPM;component/Assets/BPM.ico" Width="1080" Height="720" MinWidth="880" MinHeight="600"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#F5F7FB"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
      <Image Source="{StaticResource BPMLogo}" Width="48" Height="48" Margin="0,0,14,0"/>
      <StackPanel>
      <TextBlock Text="战网配置管理" FontSize="26" FontWeight="SemiBold" Foreground="#172D4A"/>
      <TextBlock Text="独立 Windows 用户 · 独立登录状态 · 共用游戏文件" Foreground="#5C6D82" Margin="0,6,0,0"/>
      </StackPanel>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14">
      <Button Content="添加配置" Tag="{StaticResource IconAdd}" Style="{StaticResource IconButton}" Command="{Binding AddCommand}" Background="#0969DA" Foreground="White" BorderBrush="#0969DA"/>
      <Button Content="编辑配置" Tag="{StaticResource IconEdit}" Style="{StaticResource IconButton}" Command="{Binding EditCommand}"/>
      <Button Content="桌面快捷方式" Tag="{StaticResource IconShortcut}" Style="{StaticResource IconButton}" Command="{Binding ShortcutCommand}"/>
      <Button Content="导入" Tag="{StaticResource IconImport}" Style="{StaticResource IconButton}" Command="{Binding ImportCommand}"/>
      <Button Content="导出" Tag="{StaticResource IconExport}" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}"/>
      <Button Content="删除配置" Tag="{StaticResource IconDelete}" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"/>
    </WrapPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5"
              Background="White" BorderBrush="#DCE3ED" RowHeaderWidth="0" MinRowHeight="76">
      <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Padding" Value="14,12"/><Setter Property="Background" Value="#EDF2F8"/>
          <Setter Property="Foreground" Value="#415570"/><Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
          <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value></Setter>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="配置 / Windows 用户" Width="1.1*" MinWidth="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding BattleNetPath}">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding WindowsUser}" Margin="0,5,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            </StackPanel></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="启动状态" Binding="{Binding Status}" Width="110"/>
        <DataGridTemplateColumn Header="浏览器登录辅助" Width="2*" MinWidth="230">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="操作" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Button Content="启动战网" Tag="{StaticResource IconPlay}" Style="{StaticResource IconButton}" Margin="0" VerticalAlignment="Center"
                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="暂无配置，点击“添加配置”开始" Foreground="#67788C"
               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
    </TextBlock>
    <Border Grid.Row="3" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
      <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="#EBF3FF"/><Setter Property="BorderBrush" Value="#CCDFF8"/>
        <Style.Triggers><DataTrigger Binding="{Binding SelectedAccount.NeedsAttention}" Value="True">
          <Setter Property="Background" Value="#FFF5DF"/><Setter Property="BorderBrush" Value="#E8C87F"/>
        </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconHelp}" Width="18" Height="18" Stretch="Uniform" Stroke="#415570" StrokeThickness="1.8" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="网页登录未弹出？" FontWeight="SemiBold" FontSize="15" Foreground="#172D4A"/>
        </StackPanel>
        <TextBlock Text="{Binding SelectedAccount.LoginStatus, TargetNullValue=请先添加或选择配置, FallbackValue=请先添加或选择配置}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#415570"/>
        <TextBlock Text="先重试辅助，再取消战网旧请求并重新登录。仍失败时，请手动登录一次配置绑定的 Windows 桌面。"
                   TextWrapping="Wrap" Margin="0,6,0,12" Foreground="#415570"/>
        <WrapPanel>
          <Button Content="重试登录辅助" Tag="{StaticResource IconRetry}" Style="{StaticResource IconButton}" Command="{Binding RetryLoginCommand}"/>
          <Button Content="手动登录一次 · 操作指引" Tag="{StaticResource IconHelp}" Style="{StaticResource IconButton}" Command="{Binding LoginHelpCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="#67788C" FontSize="12" TextWrapping="Wrap"
               Text="BPM 启动时自动请求管理员权限。登录辅助每轮保持 15 分钟，请保留窗口。密码仅存于 Windows 凭据管理器；辅助不会修改默认浏览器，可在编辑配置中关闭。"/>
  </Grid>
</Window>
